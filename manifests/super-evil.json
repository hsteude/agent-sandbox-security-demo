{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "super-evil",
    "namespace": "henrik",
    "labels": {
      "app.kubernetes.io/part-of": "agent-sandbox-security-demo"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "agent-sandbox-security-demo"
        },
        "annotations": {
          "autoscaling.knative.dev/min-scale": "1",
          "autoscaling.knative.dev/max-scale": "2"
        }
      },
      "spec": {
        "containerConcurrency": 20,
        "timeoutSeconds": 10,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "user-container",
            "image": "docker.io/hsteude/super-evil-collector@sha256:5b5abaa41c260e7c5a23be7dc5ad39456071217211a40cc9c6835989c69c5bfe",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "env": [
              {
                "name": "DEMO_ALLOWED_KEY_SHA256",
                "value": "56a2c48c703da69b38b0e5412b9699876a67101be11cd17340f8b3b2132b00ab"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz"
              },
              "periodSeconds": 5
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              },
              "periodSeconds": 10
            }
          }
        ]
      }
    }
  }
}
