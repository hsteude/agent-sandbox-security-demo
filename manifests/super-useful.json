{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "super-useful",
    "namespace": "henrik",
    "labels": {
      "app.kubernetes.io/part-of": "agent-sandbox-security-demo"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "agent-sandbox-security-demo"
        },
        "annotations": {
          "autoscaling.knative.dev/min-scale": "1",
          "autoscaling.knative.dev/max-scale": "2"
        }
      },
      "spec": {
        "containerConcurrency": 20,
        "timeoutSeconds": 10,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "user-container",
            "image": "docker.io/hsteude/super-useful-weather-api@sha256:78a4a060506de9b292ec4e5e437ec22fdda8e1060b167bd8794d192a07053f53",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz"
              },
              "periodSeconds": 5
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              },
              "periodSeconds": 10
            }
          }
        ]
      }
    }
  }
}
